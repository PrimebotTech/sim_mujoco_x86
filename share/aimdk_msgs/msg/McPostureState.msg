# -----------------------------------------------------------------------------------
# 机器人姿态检测结果 (security_guard 姿态检测)
# -----------------------------------------------------------------------------------

# 当前姿态
uint8 current_posture

# 未知姿态
uint8 UNKNOWN = 0

# 双足站姿
uint8 STANDING = 1

# 仰卧，面朝上
uint8 LYING_FACE_UP = 2

# 俯卧，面朝下
uint8 LYING_FACE_DOWN = 3

# 坐姿（零力矩模式下躯干直立且腿部符合坐姿构型）
uint8 SEATED = 4

# 开箱姿态
uint8 OPEN_BOX = 5
