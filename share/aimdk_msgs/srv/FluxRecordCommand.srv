# FluxRecordCommand.srv — flux 录制控制 RPC 服务

# request
string command          # "record.start" or "record.stop"
int32 duration          # seconds, 0 = use config default
---
# response
int32 status            # 0=success, non-zero=fail
int32 reason            # error reason code (0 when success)
string message          # human-readable status/error message
