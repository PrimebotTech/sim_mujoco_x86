# --------------------------------------------------------------------------------------------------------------
# hal_camera 相机关闭/打开 热切换接口
# 用于整机进入/退出低功耗或充电状态时，热关闭/热启动 相机
# --------------------------------------------------------------------------------------------------------------

# 请求头
CommonRequest request

# 请求唯一标识，用于问题定位
string trace_id

# 请求类型，0: SET 1: GET
uint8 req_type 

uint8 SET = 0
uint8 GET = 1

# 目标相机电源控制mask，0关闭 1打开
uint32 power_ctrl_mask #预留

# 目标相机出流控制mask，0关闭 1打开
uint32 stream_ctrl_mask

uint32 CAMERA_0 = 0x01 #双目左 or 低配单目
uint32 CAMERA_1 = 0x02 #双目右
uint32 CAMERA_2 = 0x04 #鱼眼左
uint32 CAMERA_3 = 0x08 #鱼眼右

